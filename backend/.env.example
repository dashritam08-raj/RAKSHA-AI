RAKSHA_ENV=development
RAKSHA_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
RAKSHA_TOKEN_TTL_HOURS=8
RAKSHA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RAKSHA_LOCATION_RETENTION_HOURS=24
RAKSHA_ENV_CACHE_SECONDS=60
DATABASE_URL=sqlite:///./raksha.db
LOG_LEVEL=INFO

# Production ML predictor loads BOTH final component models from backend/models:
#   raksha_final_shallow_hgb.joblib
#   raksha_final_log_target_hgb.joblib
# The legacy RAKSHA_ML_MODEL_PATH variable is retained only for backward-compatible
# API wiring/metadata and does not select one component model.
RAKSHA_ML_MODEL_PATH=./models

# Optional official NDMA SACHET CAP/RSS feed:
SACHET_CAP_URL=
